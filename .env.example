# App
APP_ENV=development
API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Docker Compose overrides this with PostgreSQL; this default keeps the no-Docker Demo simple.
DATABASE_URL=sqlite+aiosqlite:///./lessonforge.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-this-to-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=480
UPLOAD_MAX_MB=20
UPLOAD_DIR=artifacts/uploads
EXPORT_DIR=artifacts/exports
RATE_LIMIT_PER_MINUTE=120

# AI defaults (Demo/CI uses mock; production example uses ollama)
LLM_PROVIDER=mock
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
LOG_RAW_AI_CONTENT=false
SCHEMA_REPAIR_ATTEMPTS=2
IN_PROCESS_JOBS=true

# Local Demo only
DEMO_OWNER_EMAIL=owner@demo.lessonforge.tw
DEMO_OWNER_PASSWORD=LessonForgeDemo!2026
DEMO_TEACHER_EMAIL=teacher@demo.lessonforge.tw
DEMO_TEACHER_PASSWORD=LessonForgeDemo!2026
