# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
lessonforge.db
*.tsbuildinfo

# Generated local data
/artifacts/exports/*
!/artifacts/exports/.gitkeep
/artifacts/uploads/*
!/artifacts/uploads/.gitkeep
/artifacts/screenshots/*
!/artifacts/screenshots/.gitkeep
/artifacts/e2e-uploads/
/artifacts/e2e-exports/
/artifacts/test-uploads/
/artifacts/*.db
/artifacts/*.log
/evals/results/*
!/evals/results/.gitkeep

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
